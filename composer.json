{
    "name": "moe/laravel-marketing",
    "description": "Marketing module for MOE ecosystem — Commission, Referral, Attribution, Promo",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "emanizer@example.com"
        }
    ],
    "keywords": ["laravel", "marketing", "commission", "referral", "promo", "moe"],
    "autoload": {
        "psr-4": {
            "Moe\\Marketing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Marketing\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "moe/laravel-core": "*",
        "moe/laravel-finance": "*",
        "moe/laravel-commerce": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Marketing\\MarketingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
